import wollok.game.*

object hud {
  method position() = game.at(1, 0)
  method text() = "Tiempo: " + cronometro.segundos() + "  Puntaje: " + puntaje.total()
  method textColor() = "000000FF"  //negro
  method textSize() = 30 // pq se ve ultra chiquito (parece que no sirve xd)
}

object cronometro {
  var property segundos = 60

  method tick() { segundos = segundos - 1 }
  method seTerminoElTiempo() = segundos <= 0
  method image() = "assets/invisible.png"
  method position() = game.at(0, 9)
  method agregarTiempo(tiempoExtra){
    segundos += tiempoExtra
  }
  
}

object puntaje {
  var property total = 0
  var multiplicar = false
  method sumar(puntos) { 
    if(multiplicar){
      total +=  puntos * 2
    } else {
      total +=  puntos
    }
  }
  method image() = "assets/invisible.png"  
  method position() = game.at(3, 9)
  method multiplicador(){
    multiplicar = true
  }
  method dejarMultiplicar(){
    multiplicar = false
  }
  
}

object mapa {
  const filasDePiso = [0, 1, 2, 4, 6]       
  const columnasDeEscalera = [0, 8]
  
  method esTransitable(posicion) {
    const estaEnElMapa = posicion.x() >= 0 && posicion.x() <= 8 && posicion.y() >= 0 && posicion.y() <= 6 // se me fue para afuera
    const enPisoOEscalera = filasDePiso.contains(posicion.y()) || columnasDeEscalera.contains(posicion.x())
    return estaEnElMapa && enPisoOEscalera
  }
}

object jugador {
    var property position = game.at(4, 2) // posicion inicial
    var property tieneBolsa = false
    var property deQuePuertaEsBolsa = null

    method image() {
    if (tieneBolsa) return "assets/crashfrontalbolsa.png"
    else return "assets/frontalpersonaje.png"
  }
    
    method intentarMover(posicionNueva){
      if(mapa.esTransitable(posicionNueva)){
        position = posicionNueva
      }
    }
    method moverDerecha()   { self.intentarMover(position.right(1)) }
    method moverIzquierda() { self.intentarMover(position.left(1)) }
    method moverArriba()    { self.intentarMover(position.up(1)) }
    method moverAbajo()     { self.intentarMover(position.down(1)) }  

    method agarrar(puerta){ 
      tieneBolsa = true
      deQuePuertaEsBolsa = puerta
    }

    method soltar(){
      tieneBolsa = false
      deQuePuertaEsBolsa = null
    }
}

class Puerta {
    var property position
    var property abierta = false
    const piso

    method image() {
    if (abierta) 
      return "assets/puertanuevahombre.png"
    else 
      return "assets/puertanueva.png"
    }

    method abrir(){
        abierta = true
        //const volAbrir = game.sound("assets/puerta_abrir.wav").play()
        //volAbrir.volume(0.01)
        
    }
      // POR ALGUN MOTIVO CUANDO PONGO VOLUMEN NO FUNCIONA EL MECANISMO DE ABRIR Y CERRAR PUERTAS BIEN
    method cerrar() {
        abierta = false
        //const volCerrar = game.sound("assets/puerta_cerrar.wav").play()
        //volCerrar.volume(0.01)
        
        
    }

    method puntos() = piso * 10  // piso 1 = 10pts, piso 2 = 20pts, piso 3 = 30pts
    method tiempoDado() = 10 - (piso * 3)  // piso1=7seg, piso2=4seg, piso3=1seg

    method agarrarBolsa(){
      abierta = false
    }
}   

const puerta1 = new Puerta(position = game.at(2, 2), piso = 1)
const puerta2 = new Puerta(position = game.at(4, 2), piso = 1)  
const puerta3 = new Puerta(position = game.at(6, 2), piso = 1)
const puerta4 = new Puerta(position = game.at(2, 4), piso = 2)
const puerta5 = new Puerta(position = game.at(4, 4), piso = 2)  
const puerta6 = new Puerta(position = game.at(6, 4), piso = 2)
const puerta7 = new Puerta(position = game.at(2, 6), piso = 3)
const puerta8 = new Puerta(position = game.at(4, 6), piso = 3)  
const puerta9 = new Puerta(position = game.at(6, 6), piso = 3)



object powerUpTeletransporte {

  //method image() =

  method aplicar(unJugador){
    unJugador.position(camionRecolector.position())
  }
}

object powerUpMultiplicador {
 //method image() =

  method aplicar(unJugador){
    puntaje.multiplicador()
    game.onTick(10000,"dejarMultiplicar", {puntaje.dejarMultiplicar()})
  }
}

object powerUpCascaraDeBanana {
  //method image() =

  method aplicar(unJugador){
    unJugador.soltar()
  }
}

object powerUpRelojRoto {
  //method image() =

  method aplicar(unJugador){
    cronometro.agregarTiempo(-5)
  }
}

object camionRecolector {
  var property position = game.at(4,0)

  method image() = "assets/camionBasura.png"

  method agarrarBolsa() {
  if (jugador.deQuePuertaEsBolsa() != null) {
    puntaje.sumar(jugador.deQuePuertaEsBolsa().puntos())
    cronometro.agregarTiempo(jugador.deQuePuertaEsBolsa().tiempoDado())
  }
}
}

program juego {
  
  game.title("Trash Bandicoot")
  game.cellSize(100)
  game.width(9)  
  game.height(9)

  const fondo = game.sound("assets/musica_fondo.wav")
  fondo.shouldLoop(true)
  fondo.volume(0.1)
  keyboard.m().onPressDo({ fondo.volume(0) }) // BAJAR VOLUMEN CON LA M!!!!!!!!!

  game.schedule(500, { fondo.play()} )


   const puertas = [puerta1, puerta2, puerta3, puerta4, puerta5, puerta6, puerta7, puerta8, puerta9]
  
   /
  //game.boardGround("assets/fondo_hotel.png")
   //game.boardGround("assets/fondotemporal.jpg")
  puertas.forEach({ puerta => game.addVisual(puerta) }) // agregar visual de las puertas


  game.onTick(3000,"abrirPuertas", {
    const cerradas = puertas.filter({puerta => !puerta.abierta()})
    if (cerradas.size() > 0){
        const elegida = cerradas.get((0).randomUpTo(cerradas.size()))
        elegida.abrir()

    }
  }) // cada 3 segundos abri puerta random


    game.onTick(10000,"cerrarPuertas", 
    {puertas.filter({ puerta => puerta.abierta() }).forEach({ puerta => puerta.cerrar() }) // de las puertas cerrarlas cada 10seg (hay q probarla ni idea)
  }) // CADA 10 SEGUNDOS CERRALAS

  game.addVisual(jugador)
  game.addVisual(camionRecolector)

  keyboard.right().onPressDo({ jugador.moverDerecha() }) // movmiento
  keyboard.left().onPressDo({ jugador.moverIzquierda() })
  keyboard.up().onPressDo({ jugador.moverArriba() })
  keyboard.down().onPressDo({ jugador.moverAbajo() })

  keyboard.space().onPressDo({
    if(jugador.tieneBolsa()){
      if(jugador.position() == camionRecolector.position()){
        camionRecolector.agarrarBolsa()
        jugador.soltar()
        
      }
    } else {
      const puerta = puertas.find({ puerta => puerta.abierta() && puerta.position() == jugador.position() })
      if (puerta != null) {
        puerta.agarrarBolsa()
        jugador.agarrar(puerta)
      }
    }

    })

  game.addVisual(hud)
  game.onTick(1000,"actualizarCronometro", {
  cronometro.tick()
  if (cronometro.seTerminoElTiempo()) { game.stop() }
  }) // cada 1 segundo baja el tiempo del hud


  const powerUpsNivel1 = []

  game.start()
}